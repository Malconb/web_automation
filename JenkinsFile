pipeline {
    agent any
    parameters {
        string description: 'Markers to be executed by pytest, please set like this e.g. "-m sanity", "-m" is mandatory for markers', name: 'Tag'
        }

    stages {
        stage('python version') {
            steps {
              sh 'python3.12 --version'
            }
        }
        stage('Run Requirements & Pylint') {
            steps {
                withPythonEnv('python3.12') {
                    sh 'pip install -r requirements.txt'
                    sh 'playwright install'
                }
            }
        }
        stage('Run Python Scripts') {
            steps {
                withPythonEnv('python3.12') {
                    sh "python3.12 -m pytest test/playground/playwright/${params.Tag} -vs --alluredir reports/"
                }
            }
        }
        stage('reports') {
            steps {
                script {
                    allure includeProperties: false,
                        jdk:'',
                        properties: [],
                        reportBuildPolicy: 'ALWAYS',
                        results: [[path: 'reports/']]

                 }
            }
        }
    }
}